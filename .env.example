# Set these on the server. Generate a bootstrap hash in a private terminal.
CCI_ADMIN_EMAIL=superadmin@example.org
CCI_ADMIN_PASSWORD_HASH=
CCI_SITE_URL=

# For Supabase on Vercel, copy the shared Transaction pooler connection string.
POSTGRES_URL=
# Optional IPv4 pooler hostname if POSTGRES_URL uses a dedicated Supabase endpoint.
POSTGRES_POOLER_HOST=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Alternative for deployments that use Cloudflare D1 and R2.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_API_TOKEN=
CCI_D1_DATABASE_ID=
CCI_R2_BUCKET=
CCI_R2_ACCESS_KEY_ID=
CCI_R2_SECRET_ACCESS_KEY=
